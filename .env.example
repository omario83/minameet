NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Basis-URL voor links in e-mails. Productie: https://minameet.nl (verplicht, anders weigert `next build`).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Ondertekent de cookie met het adres op de pagina 'controleer je e-mail'. Productie verplicht; genereer met `openssl rand -base64 32`.
AUTH_COOKIE_SECRET=
# Optioneel: wachttijd (seconden) tussen twee bevestigingsmails. Standaard 60.
AUTH_RESEND_COOLDOWN_SECONDS=

# Alleen server-side, nooit met NEXT_PUBLIC_ prefix
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Optioneel: AI-zoeken (zonder sleutel gebruikt MinaMeet een eenvoudige zoekopdracht-parser)
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# Cloudflare Turnstile: verplicht voor productie-builds (zonder sleutel weigert `next build`).
# Lokaal mag hij ontbreken; dan wordt het captcha overgeslagen met een waarschuwing in de console.
# Alleen de sitesleutel staat hier. De secret key zet je in
# Supabase Dashboard > Authentication > Attack Protection (Captcha, provider Turnstile).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optioneel: e-mailherinneringen via Resend
RESEND_API_KEY=
RESEND_FROM=
# Alleen voor tests: stuurt Resend-aanroepen naar een nepserver
RESEND_API_URL=
# Alleen voor tests: wijst de adres-opzoeking (PDOK) naar een nepserver
PDOK_URL=

# E-mailadres dat een melding krijgt bij elke nieuwe partneraanmelding
ADMIN_NOTIFY_EMAIL=
